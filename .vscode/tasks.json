{
  "version": "2.0.0",
  "tasks": [
    {
      // 開いている .cpp をデバッグ用にビルド（拡張子なしの実行ファイルを同じフォルダに生成）
      "label": "C++ build (debug)",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "-std=gnu++23",
        "-g",
        "-O0",
        "-Wall",
        "-Wextra",
        "-D_GLIBCXX_DEBUG",
        "-fsanitize=undefined",
        "-fsanitize-trap=undefined",
        "-static",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "ucrt64 g++(16.1) でデバッグビルド（glibcxx debug + UBSan トラップ + static / ASan は MinGW 非対応のため除外）"
    }
  ]
}
